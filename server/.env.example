# ---------------------------------------------------------------------------
# ResumeIQ server configuration
# Copy this file to server/.env and adjust the values for your environment.
# ---------------------------------------------------------------------------

# Port the API listens on
PORT=5000

# Secret used to sign JWT access tokens. Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-secret-in-production

# Token lifetime (jsonwebtoken duration syntax: s, m, h, d)
JWT_EXPIRES=7d

# Frontend origin allowed by CORS (multiple origins are handled in app.js)
CLIENT_URL=http://localhost:5173

# Optional: when set, the app uses MongoDB through Mongoose.
# When omitted (or empty), data is persisted locally at server/.data/db.json.
# MONGODB_URI=mongodb://127.0.0.1:27017/resumeiq

# Maximum accepted resume upload size in megabytes
MAX_FILE_SIZE_MB=10

# development | production | test
NODE_ENV=development
